# Response headers for the static files (Cloudflare Workers static assets; this file itself is not served).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

# Images and fonts rarely change: browsers keep them for a week and refresh quietly after that.
/img/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/fonts/*
  Cache-Control: public, max-age=2592000, immutable

# Styles and scripts change with the site (js/config.js with every release): browsers check for a newer copy on
# every visit (a quick 304 when nothing changed), so a release shows at once instead of up to an hour later.
/css/*
  Cache-Control: public, max-age=0, must-revalidate
/js/*
  Cache-Control: public, max-age=0, must-revalidate

# Maintenance files: reachable, but not for search results.
/README.md
  X-Robots-Tag: noindex
